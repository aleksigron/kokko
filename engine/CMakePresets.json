{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared base configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug symbols, very low optimization",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "description": "Debug symbols, moderate optimization",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KOKKO_USE_TRACY": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with high optimization",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KOKKO_USE_TRACY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "debug"
    },
    {
      "name": "RelWithDebInfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "Release",
      "configurePreset": "release"
    }
  ]
}